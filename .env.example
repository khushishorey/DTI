# Copy to .env. Never commit .env; never put the Supabase service-role key here.

# Supabase -> Project Settings -> API -> Project URL. Public.
EXPO_PUBLIC_SUPABASE_URL=
# Supabase -> Project Settings -> API -> anon public key. Public (protected by Row Level Security).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: "real" uses the phone's GPS, "simulated" replays a demo route. Public. Default: real on phones, simulated on web.
# EXPO_PUBLIC_TRACKING_MODE=simulated
