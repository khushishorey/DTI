# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is safe to ship in the app because every table has Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force GPS mode. "real" uses the phone's GPS, "simulated" replays a demo route
# (useful for indoor demos). Default: real on phones, simulated on web.
# EXPO_PUBLIC_TRACKING_MODE=simulated
